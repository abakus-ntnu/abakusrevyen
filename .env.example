# Optional: leave unset to run the shell without a backend.
# Copy to .env.local and replace BOTH placeholders when a project exists.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# All VITE_* values are public. Never add secret/service-role/API tokens here.
