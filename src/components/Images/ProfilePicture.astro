---
import { Image } from "astro:assets";
import { CircleUserRound } from "lucide-astro";

interface Props {
  class: string;
  src?: ImageMetadata;
  alt: string;
}

const { class: className, src, alt, ...rest } = Astro.props;
---

{
  src ? (
    <Image
      class:list={[
        "aspect-square w-auto rounded-full object-cover object-top",
        className,
      ]}
      src={src}
      alt={alt}
      {...rest}
    />
  ) : (
    <span
      class:list={[
        "inline-flex aspect-square items-center justify-center rounded-full bg-bg-accent text-primary",
        className,
      ]}
      aria-label={alt}
      {...rest}
    >
      <CircleUserRound class="h-3/4 w-3/4" aria-hidden="true" />
    </span>
  )
}
