---
const SUBPAGES = [
  {
    name: "Opptak",
    href: "/opptak",
  },
  {
    name: "Om oss",
    href: "/om_oss",
  },
  {
    name: "Bildegalleri",
    href: "/galleri",
  },
  {
    name: "Revyer",
    href: "/revyer",
  },
  {
    name: "Kontakt",
    href: "/kontakt",
  },
  {
    name: "Personvern",
    href: "/personvern",
  },
];

import { SOCIALS } from "@/lib/constants";
import { ArrowUpRight } from "lucide-astro";
---

<footer class="mt-16 bg-background">
  <div
    class="container mx-auto grid gap-6 border-t border-gray-200 px-4 py-8 md:grid-cols-[1fr_auto_1fr] md:items-center dark:border-gray-800"
  >
    <div class="mx-auto space-y-1 text-center md:ml-0 md:text-left">
      <h1
        id="footer-title"
        class="font-serif text-2xl font-medium tracking-tight text-foreground"
      >
        Abakusrevyen
      </h1>
      <p class="text-sm opacity-70">Av studenter, for studenter.</p>
      <p class="text-xs opacity-60">Org.nr. 936 891 942</p>
    </div>

    <ul class="mx-auto flex flex-wrap justify-center gap-2">
      {
        SUBPAGES.map(({ name, href }) => (
          <li>
            <a
              href={href}
              class="hover:bg-primary/10 block rounded-full bg-bg-accent px-3 py-1.5 text-sm font-medium no-underline transition hover:text-primary"
            >
              {name}
            </a>
          </li>
        ))
      }
    </ul>

    <ul class="mx-auto flex gap-2 md:mr-0">
      {
        SOCIALS.map(({ name, external, href, Icon }) => (
          <li id={name}>
            <a
              target={external ? "_blank" : "_self"}
              rel={external ? "noopener noreferrer" : undefined}
              href={href}
              aria-label={name}
              class="group relative flex h-10 w-10 items-center justify-center rounded-md bg-bg-accent text-primary transition hover:-translate-y-0.5 hover:bg-primary hover:text-white"
            >
              <Icon class="h-5 w-5" aria-hidden="true" />
              {external && (
                <ArrowUpRight
                  class="absolute h-3 w-3 -translate-y-3 translate-x-3 opacity-0 transition group-hover:opacity-100"
                  aria-hidden="true"
                />
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
