---
import { Image } from "astro:assets";

import { PREVIOUS_REVUES, getRevueMainLink } from "@/lib/constants";
---

<div class="grid max-w-full grid-flow-col grid-rows-2 px-6 md:grid-rows-1">
  {
    PREVIOUS_REVUES.toReversed()
      .slice(0, 8)
      .map((revue) => (
        <div class="w-[1fr] transition-transform odd:-rotate-12 even:rotate-12 hover:scale-110">
          <a href={getRevueMainLink(revue)?.href || "#"} target="_blank">
            <Image
              src={revue.logo}
              alt={`${revue.name} logo`}
              loading="eager"
              class="rounded-md"
            />
          </a>
        </div>
      ))
  }
</div>
