---
import Logo from "../Branding/Logo.astro";
import ThemeSwitcher from "./ThemeSwitcher.astro";
import { Menu, X, Scroll, Users, Image, Drama, Mail } from "lucide-astro";
import { SOCIALS } from "@/lib/constants";

const PAGES = [
  { href: "/opptak", title: "Opptak", Icon: Scroll },
  { href: "/om_oss", title: "Om oss", Icon: Users },
  { href: "/galleri", title: "Bildegalleri", Icon: Image },
  { href: "/revyer", title: "Tidligere revyer", Icon: Drama },
  { href: "/kontakt", title: "Kontakt", Icon: Mail },
];
---

<header id="header" class="relative z-50 mx-auto w-full max-w-screen-xl">
  <div
    class="mx-auto flex h-[4.5rem] items-center justify-between px-4 py-2 md:h-32 md:px-6 md:py-3"
  >
    <a href="/" data-astro-prefetch="load">
      <Logo />
    </a>

    <nav class="hidden items-center justify-center gap-4 md:flex lg:gap-6">
      {
        PAGES.map(({ href, title }) => (
          <a
            class="text-lg text-foreground transition-colors hover:text-accent"
            href={href}
            data-astro-prefetch="load"
          >
            {title}
          </a>
        ))
      }
      <ThemeSwitcher mobile="false" />
    </nav>

    <div class="flex items-center gap-1 md:hidden">
      <ThemeSwitcher mobile="true" />
      <button
        id="menuButton"
        class="relative h-8 w-8 p-1"
        aria-label="Toggle Menu"
      >
        <Menu class="icon-menu transition-all" />
        <X
          class="icon-close absolute inset-1 rotate-90 opacity-0 transition-all"
        />
      </button>
    </div>
  </div>

  <div
    id="mobileMenu"
    class="pointer-events-none absolute inset-x-0 top-full flex h-[calc(100dvh-4.5rem)] flex-col gap-5 overflow-y-auto overscroll-contain bg-background px-4 py-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))] text-foreground opacity-0 transition-opacity md:hidden"
  >
    <div class="flex flex-col gap-2">
      <span class="px-2 text-base font-semibold">Sider</span>
      {
        PAGES.map(({ href, title, Icon }) => (
          <a
            class="hover:bg-primary/10 flex items-center gap-2.5 rounded-lg bg-bg-accent px-3 py-2 text-base text-foreground no-underline transition hover:text-primary"
            href={href}
            data-astro-prefetch="load"
          >
            <span class="flex h-8 w-8 items-center justify-center rounded-md bg-background text-primary">
              <Icon class="h-4 w-4" aria-hidden="true" />
            </span>
            {title}
          </a>
        ))
      }
    </div>
    <div class="flex flex-col gap-2">
      <span class="px-2 text-base font-semibold">Kontakt oss</span>
      {
        SOCIALS.map(({ name, href, external, Icon }) => (
          <a
            class="hover:bg-primary/10 flex items-center gap-2.5 rounded-lg bg-bg-accent px-3 py-2 text-base text-foreground no-underline transition hover:text-primary"
            href={href}
            target={external ? "_blank" : "_self"}
            rel={external ? "noopener noreferrer" : undefined}
            data-astro-prefetch="load"
          >
            <span class="flex h-8 w-8 items-center justify-center rounded-md bg-background text-primary">
              <Icon class="h-4 w-4" aria-hidden="true" />
            </span>
            {name}
          </a>
        ))
      }
    </div>
  </div>
  <script is:inline>
    const header = document.getElementById("header");
    const menuButton = document.getElementById("menuButton");
    const menuIcon = menuButton.querySelector(".icon-menu");
    const closeIcon = menuButton.querySelector(".icon-close");

    let menuOpen = false;

    function toggleMenu(forceClose = false) {
      menuOpen = forceClose ? false : !menuOpen;

      menuIcon.classList.toggle("rotate-90", menuOpen);
      menuIcon.classList.toggle("opacity-0", menuOpen);
      closeIcon.classList.toggle("rotate-0", menuOpen);
      closeIcon.classList.toggle("opacity-100", menuOpen);

      if (menuOpen) {
        header.classList.add("fixed", "top-0", "left-0", "bg-background");
        mobileMenu.classList.add("opacity-100");
        mobileMenu.classList.remove("pointer-events-none");
        document.body.style.overflow = "hidden";
      } else {
        header.classList.remove("fixed", "top-0", "left-0", "bg-background");
        mobileMenu.classList.remove("opacity-100");
        mobileMenu.classList.add("pointer-events-none");
        document.body.style.overflow = "";
      }
    }

    menuButton.addEventListener("click", () => toggleMenu());
    window.addEventListener("resize", () => {
      if (window.innerWidth >= 768 && menuOpen) toggleMenu(true);
    });
  </script>
</header>
