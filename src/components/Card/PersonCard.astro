---
import { CircleUserRound } from "lucide-astro";

interface Props {
  name: string;
  image?: string | ImageMetadata;
  holo?: boolean;
  shine?: boolean;
  glow?: boolean;
  naturalImage?: boolean;
}

const {
  name,
  image,
  holo = false,
  shine = false,
  glow = false,
  naturalImage = false,
} = Astro.props;
const shouldShine = holo || shine;
const imageSource = image
  ? typeof image === "string"
    ? image
    : image.src
  : undefined;
---

<div
  class:list={[
    "person-card flex aspect-[5/6] w-full flex-col rounded-lg",
    !imageSource && "bg-bg-accent",
    shouldShine && "shine-card",
    holo && "holo-card",
    glow && "glow-card",
    naturalImage && "natural-image",
  ]}
  style={imageSource ? `--person-image: url(${imageSource})` : undefined}
>
  {imageSource && <span class="person-image" aria-hidden="true" />}
  {holo && <span class="holo-rainbow" aria-hidden="true" />}
  {
    shouldShine && (
      <span class="shine-layer" aria-hidden="true">
        <span class="shine-line" />
      </span>
    )
  }
  <div class="card-media">
    {
      !imageSource && (
        <div class="relative z-10 flex h-full items-center justify-center text-primary opacity-70">
          <CircleUserRound class="h-24 w-24" aria-hidden="true" />
        </div>
      )
    }
  </div>
  <div
    class="relative z-20 mx-1.5 mb-1.5 w-[calc(100%-0.75rem)] rounded-md bg-background px-2 py-1 text-center text-sm opacity-90 sm:px-3 sm:text-base"
  >
    <slot name="name">
      <h6 class="font-bold">
        {name}
      </h6>
    </slot>
    <slot />
  </div>
</div>

<style>
  .person-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .person-image {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    background-image: var(--person-image);
    background-position: center top;
    background-size: cover;
    transition: filter 220ms ease;
  }

  .person-image::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .natural-image .person-image {
    filter: none;
  }

  .natural-image .person-image::after {
    content: none;
  }

  .shine-card {
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0),
      0 0 24px rgb(255 255 255 / 0);
    transition: box-shadow 220ms ease;
  }

  .card-media {
    position: relative;
    z-index: 10;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    border-radius: 0.375rem 0.375rem 0 0;
  }

  .holo-card .holo-rainbow,
  .shine-card .shine-layer {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    overflow: hidden;
  }

  .holo-card .holo-rainbow {
    z-index: 1;
    background: linear-gradient(
      135deg,
      rgb(56 189 248 / 0.3),
      rgb(168 85 247 / 0.22),
      rgb(34 197 94 / 0.24),
      rgb(244 114 182 / 0.22)
    );
    opacity: 0;
    transition: opacity 220ms ease;
  }

  .shine-card .shine-layer {
    z-index: 15;
  }

  .shine-card .shine-line {
    position: absolute;
    left: 50%;
    top: 50%;
    height: 180%;
    width: 180%;
    background: linear-gradient(
      90deg,
      transparent calc(50% - 10px),
      rgb(255 255 255 / 0.75) 50%,
      transparent calc(50% + 10px)
    );
    filter: blur(18px);
    mix-blend-mode: screen;
    opacity: 0;
    transform: translate(-50%, -50%) rotate(14deg) translateX(-80%);
    transition:
      opacity 120ms ease,
      transform 520ms ease-out;
  }

  @media (hover: hover) and (pointer: fine) {
    .person-image {
      filter: saturate(0.82) contrast(0.96) brightness(0.95);
    }

    .person-image::after {
      background: linear-gradient(180deg, rgb(0 0 0 / 0.08), rgb(0 0 0 / 0.2));
    }

    .person-card:hover .person-image,
    .person-card:focus-within .person-image {
      filter: none;
    }

    .shine-card:hover,
    .shine-card:focus-within {
      box-shadow:
        0 0 0 1px rgb(255 255 255 / 0.18),
        0 0 24px rgb(255 255 255 / 0.12);
    }

    .holo-card:hover,
    .holo-card:focus-within {
      box-shadow:
        0 0 0 1px rgb(255 255 255 / 0.22),
        0 0 26px rgb(65 201 255 / 0.26),
        0 0 44px rgb(244 114 182 / 0.16);
    }

    .shine-card:hover .shine-line,
    .shine-card:focus-within .shine-line {
      opacity: 1;
      transform: translate(-50%, -50%) rotate(14deg) translateX(80%);
    }

    .holo-card:hover .holo-rainbow,
    .holo-card:focus-within .holo-rainbow {
      opacity: 1;
    }
  }

  @media (hover: none), (pointer: coarse) {
    .glow-card {
      box-shadow:
        0 0 0 1px rgb(255 255 255 / 0.16),
        0 0 24px rgb(255 255 255 / 0.12);
    }
  }
</style>
