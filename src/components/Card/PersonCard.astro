---
import { CircleUserRound } from "lucide-astro";

interface Props {
  name: string;
  image?: string | ImageMetadata;
  holo?: boolean;
}

const { name, image, holo = false } = Astro.props;
const imageSource = image
  ? typeof image === "string"
    ? image
    : image.src
  : undefined;
---

<div
  class:list={[
    "flex aspect-[5/6] w-full flex-col rounded-lg bg-cover bg-center",
    !imageSource && "bg-bg-accent",
    holo && "holo-card",
  ]}
  style={imageSource ? `background-image: url(${imageSource})` : undefined}
>
  {holo && <span class="holo-rainbow" aria-hidden="true" />}
  <div class="card-media">
    {
      holo && (
        <span class="holo-shine-layer" aria-hidden="true">
          <span class="holo-shine" />
        </span>
      )
    }
    {
      !imageSource && (
        <div class="relative z-10 flex h-full items-center justify-center text-primary opacity-70">
          <CircleUserRound class="h-24 w-24" aria-hidden="true" />
        </div>
      )
    }
  </div>
  <div
    class="relative z-20 mx-1.5 mb-1.5 w-[calc(100%-0.75rem)] rounded-md bg-background px-3 py-1 text-center opacity-90"
  >
    <slot name="name">
      <h6 class="font-bold">
        {name}
      </h6>
    </slot>
    <slot />
  </div>
</div>

<style>
  .holo-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0),
      0 0 26px rgb(65 201 255 / 0),
      0 0 44px rgb(244 114 182 / 0);
    transition: box-shadow 220ms ease;
  }

  .card-media {
    position: relative;
    z-index: 10;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    border-radius: 0.375rem 0.375rem 0 0;
  }

  .holo-card .holo-rainbow,
  .holo-card .holo-shine-layer {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    overflow: hidden;
  }

  .holo-card .holo-rainbow {
    z-index: 1;
    background: linear-gradient(
      135deg,
      rgb(56 189 248 / 0.3),
      rgb(168 85 247 / 0.22),
      rgb(34 197 94 / 0.24),
      rgb(244 114 182 / 0.22)
    );
    opacity: 0;
    transition: opacity 220ms ease;
  }

  .holo-card .holo-shine-layer {
    z-index: 1;
  }

  .holo-card .holo-shine {
    position: absolute;
    left: 50%;
    top: 50%;
    height: 180%;
    width: 180%;
    background: linear-gradient(
      90deg,
      transparent calc(50% - 10px),
      rgb(255 255 255 / 0.75) 50%,
      transparent calc(50% + 10px)
    );
    filter: blur(18px);
    mix-blend-mode: screen;
    opacity: 0;
    transform: translate(-50%, -50%) rotate(14deg) translateX(-80%);
    transition:
      opacity 120ms ease,
      transform 520ms ease-out;
  }

  .holo-card:hover,
  .holo-card:focus-within {
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.22),
      0 0 26px rgb(65 201 255 / 0.26),
      0 0 44px rgb(244 114 182 / 0.16);
  }

  .holo-card:hover .holo-shine,
  .holo-card:focus-within .holo-shine {
    opacity: 1;
    transform: translate(-50%, -50%) rotate(14deg) translateX(80%);
  }

  .holo-card:hover .holo-rainbow,
  .holo-card:focus-within .holo-rainbow {
    opacity: 1;
  }
</style>
