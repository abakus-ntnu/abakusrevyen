---
import PageLayout from "@/layouts/PageLayout.astro";

import MultiImageCard from "@/components/Card/MultiImageCard.astro";
import Title from "@/components/Common/Title.astro";
import Timeline from "@/components/Timeline/Timeline.astro";
import TimelineDate from "@/components/Timeline/TimelineDate.astro";
import ProfilePicture from "@/components/Images/ProfilePicture.astro";
import { Image } from "astro:assets";

import { SHOWS } from "@/lib/shows";
import { getCollection } from "astro:content";

import { ArrowRight, Calendar, MapPin, Pencil } from "lucide-astro";

const om_oss = await getCollection("om_oss");
const groups = await getCollection("grupper");
const leaders = await getCollection("ledere");

const spotlight = groups[0];
const spotlightLeader = leaders[0];
---

<PageLayout title="Om oss">
  <div
    id="root"
    data-groups={JSON.stringify(groups)}
    data-leaders={JSON.stringify(leaders)}
    class="container mx-auto space-y-6 px-3"
  >
    <Title>
      Om <span class="text-primary" id="about-branding">Abakusrevyen</span>
    </Title>

    <div
      class="mx-auto grid max-w-screen-sm grid-cols-2 gap-10 py-6 md:gap-16 md:px-6 lg:gap-24"
    >
      <a href="/grupper" class="group" id="groups-card" data-role="groups-card">
        <MultiImageCard
          images={[groups[0], groups[1], groups[2]].map((group) => ({
            src: group.data.logo,
            alt: `${group.data.name} logo`,
          }))}
        >
          Revygruppene
        </MultiImageCard>
      </a>

      <a
        href="/ledere"
        class="group"
        id="leaders-card"
        data-role="leaders-card"
      >
        <MultiImageCard
          images={[leaders[0], spotlightLeader, leaders[1]].map((leader) => ({
            src: leader?.data.image,
            alt: `${leader!.data.name}`,
          }))}
        >
          Lederne
        </MultiImageCard>
      </a>
    </div>

    <div id="shows" class="grid max-h-fit grid-cols-1 gap-6 md:grid-cols-2">
      <div class="order-3 space-y-3 md:order-1">
        <h2 class="text-lg font-bold">Forestillinger</h2>

        <Timeline class="w-full max-w-none">
          {
            SHOWS.map((show) => (
              <TimelineDate date={show.when}>
                <div class="hover:border-primary/60 rounded-lg border border-gray-200 bg-background p-4 transition hover:-translate-y-0.5 hover:bg-bg-accent hover:shadow-md dark:border-gray-800">
                  <div class="flex flex-col gap-3">
                    <div class="flex items-start justify-between gap-3">
                      <a
                        href={show.tickets.live}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-lg font-semibold text-foreground no-underline transition hover:text-primary"
                      >
                        {show.name}
                      </a>
                      <Calendar
                        class="mt-1 h-5 w-5 shrink-0 text-primary"
                        aria-hidden="true"
                      />
                    </div>

                    <div class="flex items-center gap-2 text-sm opacity-75">
                      <MapPin class="h-4 w-4 shrink-0" aria-hidden="true" />
                      <a
                        href={show.where.mapLink}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-foreground underline transition hover:text-primary"
                      >
                        {show.where.name}
                      </a>
                    </div>
                  </div>
                </div>
              </TimelineDate>
            ))
          }
        </Timeline>
      </div>
      <div class="order-2 flex flex-col gap-3">
        <h2 class="text-lg font-bold">Spotlight</h2>

        <div data-role="spotlight">
          <a
            href={`/grupper/${spotlight.slug}`}
            data-spotlight="href"
            class="hover:border-primary/60 group flex overflow-hidden rounded-lg border border-gray-200 bg-background no-underline transition hover:-translate-y-0.5 hover:bg-bg-accent hover:shadow-md dark:border-gray-800"
          >
            <div class="relative min-h-40 w-32 shrink-0 sm:w-40">
              <Image
                src={spotlight.data.logo}
                alt="Spotlight group logo"
                loading="eager"
                class="h-full w-full object-cover object-center"
                data-spotlight="logo"
              />
              <ProfilePicture
                src={spotlightLeader.data.image}
                alt="Spotlight leader"
                class="absolute bottom-2 right-2 h-12 border-2 border-background opacity-80 transition group-hover:opacity-100"
                data-spotlight="leader"
              />
            </div>
            <div class="flex min-w-0 flex-1 flex-col justify-between gap-4 p-4">
              <div>
                <span class="text-sm font-medium text-primary">Spotlight</span>
                <h3 class="mt-1 text-xl font-semibold" data-spotlight="name">
                  {spotlight.data.name}
                </h3>
              </div>
              <p
                class="text-sm leading-relaxed opacity-75 sm:text-base md:text-sm lg:text-base"
                data-spotlight="desc"
              >
                {spotlight.data.spotlight ?? spotlight.data.brief}
              </p>
              <span
                class="inline-flex items-center gap-2 text-sm font-medium text-primary"
              >
                Les mer
                <ArrowRight
                  class="h-4 w-4 transition group-hover:translate-x-1"
                  aria-hidden="true"
                />
              </span>
            </div>
          </a>
        </div>
      </div>
    </div>

    <div class="space-y-6">
      <h2 class="text-lg font-bold">Innlegg</h2>
      <ul class="space-y-3">
        {
          om_oss
            .sort((a, b) => (b.data.pubDate < a.data.pubDate ? 1 : -1))
            .map(
              ({
                slug,
                data: { title, pubDate, updateDate, description, image },
              }) => (
                <li>
                  <a
                    href={`/om_oss/${slug}`}
                    class="hover:border-primary/60 group flex overflow-hidden rounded-lg border border-gray-200 bg-background no-underline transition hover:-translate-y-0.5 hover:bg-bg-accent hover:shadow-md dark:border-gray-800"
                  >
                    <div class="relative h-44 w-full shrink-0 overflow-hidden bg-bg-accent sm:h-auto sm:w-56">
                      <Image
                        src={image}
                        alt={`${title} post`}
                        class="h-full w-full object-cover object-top transition duration-300 group-hover:scale-[1.03]"
                      />
                    </div>

                    <div class="flex min-w-0 flex-1 flex-col justify-between gap-5 p-4 sm:p-5">
                      <div class="space-y-2">
                        <h3 class="text-lg font-semibold text-foreground transition group-hover:text-primary">
                          {title}
                        </h3>
                        <p class="text-sm leading-relaxed opacity-80 sm:text-base">
                          {description}
                        </p>
                      </div>

                      <div class="flex flex-wrap items-center justify-between gap-3">
                        <div class="flex flex-wrap gap-2 text-sm">
                          <span class="inline-flex items-center gap-2 rounded-full border border-gray-200 px-3 py-1 opacity-80 dark:border-gray-800">
                            <Calendar class="h-4 w-4 text-primary" />
                            {pubDate.toLocaleString("NO-nb", {
                              day: "numeric",
                              month: "numeric",
                              year: "numeric",
                            })}
                          </span>
                          <span class="inline-flex items-center gap-2 rounded-full border border-gray-200 px-3 py-1 opacity-80 dark:border-gray-800">
                            <Pencil class="h-4 w-4 text-primary" />
                            {(updateDate ?? pubDate).toLocaleString("NO-nb", {
                              day: "numeric",
                              month: "numeric",
                              year: "numeric",
                            })}
                          </span>
                        </div>
                        <span class="inline-flex items-center gap-2 text-sm font-medium text-primary">
                          Les mer
                          <ArrowRight
                            class="h-4 w-4 transition group-hover:translate-x-1"
                            aria-hidden="true"
                          />
                        </span>
                      </div>
                    </div>
                  </a>
                </li>
              ),
            )
        }
      </ul>
    </div>
  </div>
  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const root = document.getElementById("root");
      if (!root) return;

      const groups = JSON.parse(root.dataset.groups);
      const leaders = JSON.parse(root.dataset.leaders);

      const spotlightGroupIdx = Math.floor(Math.random() * groups.length);
      const spotlight = groups[spotlightGroupIdx];
      const spotlightLeader =
        leaders.find((l) => l.slug === spotlight.data.leaders?.[0].slug) ??
        leaders[0];

      const selectedGroups = [
        groups[(spotlightGroupIdx + 1) % groups.length],
        groups[spotlightGroupIdx],
        groups[(spotlightGroupIdx + 2) % groups.length],
      ];

      const groupCard = document.querySelector("[data-role='groups-card']");
      if (groupCard) {
        selectedGroups.forEach((g, i) => {
          const img = groupCard.querySelector(`[data-card-image='${i}']`);
          if (img) {
            img.src = g.data.logo.src;
            img.alt = `${g.data.name} logo`;
            img.classList.remove("hidden");
          }
        });
      }

      const leaderCard = document.querySelector("[data-role='leaders-card']");
      if (leaderCard) {
        selectedGroups.forEach((g, i) => {
          const leader = leaders.find(
            (l) => l.slug === g.data.leaders?.[0].slug,
          );
          const img = leaderCard.querySelector(`[data-card-image='${i}']`);
          const fallback = leaderCard.querySelector(
            `[data-card-fallback='${i}']`,
          );
          if (img && leader) {
            if (leader.data.image?.src) {
              img.src = leader.data.image.src;
              img.classList.remove("hidden");
              fallback?.classList.add("hidden");
              fallback?.classList.remove("flex");
            } else {
              img.classList.add("hidden");
              fallback?.classList.remove("hidden");
              fallback?.classList.add("flex");
            }
            img.alt = leader.data.name;
          }
        });
      }

      const spotlightCard = document.querySelector("[data-role='spotlight']");
      if (spotlightCard) {
        spotlightCard.querySelector("[data-spotlight='logo']").src =
          spotlight.data.logo.src;
        spotlightCard.querySelector("[data-spotlight='logo']").alt =
          `${spotlight.data.name} logo`;
        const spotlightLeaderImage = spotlightCard.querySelector(
          "[data-spotlight='leader']",
        );
        if (spotlightLeaderImage && spotlightLeader.data.image?.src) {
          spotlightLeaderImage.src = spotlightLeader.data.image.src;
        }
        spotlightCard.querySelector("[data-spotlight='name']").textContent =
          spotlight.data.name;
        spotlightCard.querySelector("[data-spotlight='desc']").textContent =
          spotlight.data.spotlight ?? spotlight.data.brief;
        const spotlightLink = spotlightCard.querySelector(
          "[data-spotlight='href']",
        );
        if (spotlightLink) {
          spotlightLink.href = `/grupper/${spotlight.slug}`;
        }
      }
    });
  </script>
</PageLayout>
