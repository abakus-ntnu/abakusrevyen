---
import PageLayout from "@/layouts/PageLayout.astro";

import ProseArea from "@/components/Common/ProseArea.astro";
import Link from "@/components/LinkButton/Link.astro";
import { Image } from "astro:assets";
import { CircleUserRound, Mail, Users } from "lucide-astro";

import { getEntries } from "astro:content";
import {
  getEntry,
  render,
  getCollection,
  type ValidContentEntrySlug,
} from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("ledere");
  const list = entries.map((entry) => ({ params: { slug: entry.slug } }));
  return list;
}

const { slug }: { slug: ValidContentEntrySlug<"ledere"> } = Astro.params;

const entry = await getEntry("ledere", slug);
const { name, email, image, leaderOf, activeIn = [] } = entry.data;

const groups = await getEntries([
  ...leaderOf.map((ref) => ref.group),
  ...activeIn,
]);

function getGroup(groupRef: {
  collection: "grupper";
  slug: ValidContentEntrySlug<"grupper">;
}) {
  return groups.find((group) => group.slug === groupRef.slug);
}

const alt = leaderOf
  .map((ref) => `${ref.title} of ${getGroup(ref.group)?.data.name}`)
  .join(", ");

const leaderOfGroups = leaderOf.reduce(
  (acc, ref) => {
    const group = getGroup(ref.group);
    if (!group) return acc;

    acc[ref.title] = [group, ...(acc[ref.title] ?? [])];
    return acc;
  },
  {} as Record<string, NonNullable<ReturnType<typeof getGroup>>[]>,
);

const activeInGroups = activeIn
  .map((ref) => getGroup(ref))
  .filter((group): group is NonNullable<typeof group> => group !== undefined);

const { Content } = await render(entry);
---

<PageLayout title={name}>
  <div
    class="container mx-auto flex flex-col items-center gap-4 px-4 py-5 md:gap-6 md:py-8"
  >
    {
      image ? (
        <Image
          src={image}
          width={500}
          height={500}
          alt={alt}
          class="aspect-[5/6] w-44 rounded-lg object-cover object-top sm:w-56"
        />
      ) : (
        <div
          class="flex aspect-[5/6] w-44 items-center justify-center rounded-lg bg-bg-accent text-primary sm:w-56"
          aria-label={alt}
        >
          <CircleUserRound
            class="h-24 w-24 opacity-70 sm:h-28 sm:w-28"
            aria-hidden="true"
          />
        </div>
      )
    }

    <ProseArea
      class="gap-2 px-0 text-center prose-h1:mb-0 prose-h1:mt-0 prose-p:my-0"
    >
      <Content />
    </ProseArea>

    <section class="grid w-full max-w-screen-sm gap-3">
      {
        email ? (
          <a
            href={`mailto:${email}`}
            class="hover:border-primary/60 group flex items-center justify-between gap-4 rounded-lg border border-gray-200 bg-background p-4 no-underline transition hover:-translate-y-0.5 hover:bg-bg-accent hover:shadow-md dark:border-gray-800"
          >
            <span class="flex min-w-0 items-center gap-3">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-bg-accent text-primary transition group-hover:bg-primary group-hover:text-white">
                <Mail class="h-5 w-5" aria-hidden="true" />
              </span>
              <span class="min-w-0">
                <span class="block text-sm opacity-70">Kontakt</span>
                <span class="block truncate font-medium">{email}</span>
              </span>
            </span>
          </a>
        ) : (
          <div class="rounded-lg border border-gray-200 bg-background p-4 dark:border-gray-800">
            <span class="text-sm opacity-70">Ingen emailadresse</span>
          </div>
        )
      }

      <div
        class="rounded-lg border border-gray-200 bg-background p-4 dark:border-gray-800"
      >
        <div class="mb-4 flex items-center gap-3">
          <span
            class="flex h-10 w-10 items-center justify-center rounded-md bg-bg-accent text-primary"
          >
            <Users class="h-5 w-5" aria-hidden="true" />
          </span>
          <h2 class="text-lg font-semibold">Grupper</h2>
        </div>

        <div class="grid gap-3">
          {
            Object.entries(leaderOfGroups).map(([title, groups]) => (
              <div class="rounded-md bg-bg-accent px-3 py-2">
                <span class="block text-sm font-medium opacity-70">
                  {title}
                </span>
                <div class="mt-1 flex flex-wrap gap-x-2 gap-y-1">
                  {groups.map((group) => (
                    <Link href={`/grupper/${group.slug}`}>
                      {group.data.name}
                    </Link>
                  ))}
                </div>
              </div>
            ))
          }
          {
            activeInGroups.length > 0 && (
              <div class="rounded-md bg-bg-accent px-3 py-2">
                <span class="block text-sm opacity-70">Også aktiv i</span>
                <div class="mt-1 flex flex-wrap gap-x-2 gap-y-1">
                  {activeInGroups.map((group) => (
                    <Link href={`/grupper/${group.slug}`}>
                      {group.data.name}
                    </Link>
                  ))}
                </div>
              </div>
            )
          }
        </div>
      </div>
    </section>
  </div>
</PageLayout>
