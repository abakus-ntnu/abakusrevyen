---
import PageLayout from "@/layouts/PageLayout.astro";

import Grid from "@/components/Common/Grid.astro";
import Title from "@/components/Common/Title.astro";
import PersonCard from "@/components/Card/PersonCard.astro";
import Link from "@/components/LinkButton/Link.astro";

import { getCollection } from "astro:content";
import type { ValidContentEntrySlug } from "astro:content";

const leaders = await getCollection("ledere");

const supremeLeaderOrder = ["Nestleder", "Revysjef", "Økonomiansvarlig"];
const roleOrder = [
  "Regissør",
  "Assisterende regissør",
  "Musikalsk regissør",
  "Bandsjef",
];
const groupOrder = [
  "skuespill",
  "arring",
  "band",
  "manus",
  "dans",
  "scene",
  "teknikk",
  "kostyme",
  "pr",
  "sosial",
];

function sortableIndex(value: string | undefined, order: string[]) {
  const index = value ? order.indexOf(value) : -1;
  return index === -1 ? order.length : index;
}

function leaderRoleIndex(leader: (typeof leaders)[number]) {
  return Math.min(
    ...leader.data.leaderOf
      .filter(({ group }) => group.slug !== "revystyret")
      .map(({ title }) => sortableIndex(title, roleOrder)),
  );
}

function leaderGroupIndex(leader: (typeof leaders)[number]) {
  return Math.min(
    ...leader.data.leaderOf
      .filter(({ group }) => group.slug !== "revystyret")
      .map(({ group }) => sortableIndex(group.slug, groupOrder)),
  );
}

const supremeLeaders = leaders
  // Only get the supreme leaders
  .filter(
    (leader) =>
      leader.data.leaderOf.find(({ group }) => group.slug === "revystyret") !==
      undefined,
  )
  // And only show the leaders who should be visible
  .filter((leader) => !leader.data.hidden)
  // Sort the leaders above other titles
  .map((leader) => ({
    ...leader,
    data: {
      ...leader.data,
      title: leader.data.leaderOf.find(
        ({ group }) => group.slug === "revystyret",
      )?.title,
    },
  }))
  .toSorted((a, b) => {
    return (
      sortableIndex(a.data.title, supremeLeaderOrder) -
      sortableIndex(b.data.title, supremeLeaderOrder)
    );
  });

// Find the correct pronoun for the supreme leaders
const supremeLeaderPronoun =
  supremeLeaders.length > 1
    ? "de" // Multiple leaders
    : supremeLeaders[0].data.gender === "male"
      ? "han" // Male leader
      : supremeLeaders[0].data.gender === "female"
        ? "hun" // Female leader
        : "hen"; // Other

const plebians = leaders
  // Get those that arent (or arent just) supreme leaders
  .filter(
    (leader) =>
      leader.data.leaderOf.find(({ group }) => group.slug !== "revystyret") !==
      undefined,
  )
  // And only show the leaders who should be visible
  .filter((leader) => !leader.data.hidden)
  // And again sort the leaders above other titles
  .map((leader) => ({
    ...leader,
    data: {
      ...leader.data,
      title: leader.data.leaderOf.toSorted((a, b) => {
        const roleDiff =
          sortableIndex(a.title, roleOrder) - sortableIndex(b.title, roleOrder);
        if (roleDiff !== 0) return roleDiff;

        return (
          sortableIndex(a.group.slug, groupOrder) -
          sortableIndex(b.group.slug, groupOrder)
        );
      })[0].title,
    },
  }))
  .toSorted((a, b) => {
    const roleDiff = leaderRoleIndex(a) - leaderRoleIndex(b);
    if (roleDiff !== 0) return roleDiff;

    const groupDiff = leaderGroupIndex(a) - leaderGroupIndex(b);
    if (groupDiff !== 0) return groupDiff;

    return a.data.name.localeCompare(b.data.name, "nb");
  });

// Get the groups of the leaders
const groups = await getCollection("grupper");

function getGroup(groupRef: {
  collection: "grupper";
  slug: ValidContentEntrySlug<"grupper">;
}) {
  return groups.find((group) => group.slug === groupRef.slug);
}
---

<PageLayout title="Ledere">
  <div class="container mx-auto space-y-5 p-4 text-center md:space-y-6 md:p-6">
    <Title>
      Møt revyens <span class="text-primary">ledere</span>
    </Title>

    <p class="mx-auto max-w-prose">
      For å få revyen til å gå rundt må noen ta ansvaret for å lede arbeidet.
      Årets revystyre består av {supremeLeaderPronoun} her.
    </p>

    <div
      class="mx-auto grid w-full max-w-screen-lg grid-cols-2 items-center gap-4 py-3 sm:grid-cols-3 sm:gap-x-6 sm:gap-y-8 sm:py-8 lg:gap-x-16 lg:gap-y-10 lg:py-10"
    >
      {
        supremeLeaders.map(({ slug, data: { name, title, image } }) => (
          <a
            href={`/ledere/${slug}`}
            class:list={[
              "leader-link mx-auto w-full",
              title === "Revysjef" &&
                "revysjef-link order-1 col-span-2 max-w-64 sm:order-2 sm:col-span-1 sm:max-w-80 sm:scale-110",
              title === "Nestleder" &&
                "order-2 max-w-56 sm:order-1 sm:max-w-72",
              title === "Økonomiansvarlig" &&
                "order-3 max-w-56 sm:order-3 sm:max-w-72",
            ]}
          >
            <PersonCard
              name={name}
              image={image}
              naturalImage
              shine
              shineTone="red"
              glow
            >
              <span class="font-medium text-primary">{title}</span>
            </PersonCard>
          </a>
        ))
      }
    </div>

    <p class="mx-auto max-w-prose">
      Men {supremeLeaderPronoun} kan ikke få til alt alene! For å virkelig få revyen
      i gang trenger vi også ledere for hver av revyens <Link href="/grupper"
        >grupper</Link
      >. De rollene fylles av disse fantastiske folka!
    </p>

    <Grid
      class="!grid-cols-2 !gap-4 pt-3 sm:!grid-cols-2 md:!grid-cols-3 md:!gap-8 md:pt-6 lg:!grid-cols-4"
    >
      {
        plebians.map(({ slug, data: { name, title, image, leaderOf } }) => (
          <a href={`/ledere/${slug}`} class="leader-link">
            <PersonCard
              name={name}
              image={image}
              shine
              holo={leaderOf.some(({ group }) => group.slug === "teknikk")}
              delayHolo={leaderOf.some(({ group }) => group.slug === "teknikk")}
              glow={slug === "william-saether"}
            >
              {title} av{" "}
              <span class="font-medium text-primary">
                {leaderOf
                  .map((ref) => getGroup(ref.group)?.data.name)
                  .join(", ")}
              </span>
            </PersonCard>
          </a>
        ))
      }
    </Grid>
  </div>
</PageLayout>

<style>
  .leader-link {
    transition: transform 180ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .leader-link:hover {
      transform: scale(1.05);
    }

    .revysjef-link:hover {
      transform: scale(1.15);
    }
  }
</style>
