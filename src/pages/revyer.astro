---
import PageLayout from "@/layouts/PageLayout.astro";

import Card from "@/components/Card/Card.astro";
import CardContent from "@/components/Card/CardContent.astro";
import LinkButton from "@/components/LinkButton/LinkButton.astro";
import Title from "@/components/Common/Title.astro";
import { Image } from "astro:assets";

import { PREVIOUS_REVUES } from "@/lib/constants";
---

<PageLayout title="Tidligere Revyer">
  <div class="container mx-auto mb-12 p-3">
    <Title class="pb-2">Tidligere Revyer</Title>
    <ul
      class="grid grid-cols-1 gap-3 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4"
    >
      {
        PREVIOUS_REVUES.toSorted((a, b) => b.year.localeCompare(a.year)).map(
          (revue) => {
            const links =
              revue.links ?? (revue.mainLink ? [revue.mainLink] : []);

            return (
              <li>
                <Card class={revue.color + " !border-0"}>
                  <CardContent>
                    <Image
                      src={revue.logo}
                      alt={`Logo for ${revue.name}`}
                      class="aspect-square rounded-t-md object-contain"
                      loading="eager"
                    />
                    <h2 class={revue.dark ? "text-white" : "text-black"}>
                      {revue.year}: {revue.name}
                    </h2>
                    <div class="flex w-full flex-wrap items-start gap-2">
                      {links.map((link) =>
                        link.href ? (
                          <LinkButton
                            href={link.href}
                            class="min-w-0 flex-1 whitespace-nowrap text-center"
                            style={"secondary"}
                            external
                          >
                            {link.name}
                          </LinkButton>
                        ) : (
                          <i class="min-w-0 flex-1 cursor-not-allowed whitespace-nowrap rounded-md border-2 border-gray-300 bg-gray-300 p-1 text-center text-black">
                            {link.name}
                          </i>
                        ),
                      )}
                      {revue.playlistLink?.href ? (
                        <LinkButton
                          href={revue.playlistLink.href}
                          class="min-w-0 flex-1 whitespace-nowrap text-center"
                          style={"secondary"}
                          external
                        >
                          {revue.playlistLink.name || "Se spilleliste"}
                        </LinkButton>
                      ) : null}
                    </div>
                  </CardContent>
                </Card>
              </li>
            );
          },
        )
      }
    </ul>
  </div>
</PageLayout>
